# Clara no usa APIs de pago ni claves. Todo corre en local (LLM, STT, TTS, RAG).
# Copia este archivo a `.env` solo si quieres cambiar un valor; si no, los
# defectos de `app/config.py` bastan. Exporta las variables o prefíjalas al
# arrancar: `POSTOP_HOST=0.0.0.0 bash scripts/run.sh`

# --- Servidor ---
POSTOP_HOST=127.0.0.1
POSTOP_PORT=8000

# --- Hardware ---
# principal ≈ 7 GB (whisper small + Kokoro) · ligero ≈ 5.5 GB (whisper base + Piper)
POSTOP_PROFILE=principal
POSTOP_LLM_THREADS=4
POSTOP_STT_THREADS=4

# --- Rutas (opcionales; por defecto son ./models y ./data) ---
# POSTOP_MODELS_DIR=models
# POSTOP_DATA_DIR=data
# POSTOP_DATASET_DIR=/ruta/al/dataset/del/reto

# --- LLM local (llama-server; no hay API key) ---
POSTOP_LLM_HOST=127.0.0.1
POSTOP_LLM_PORT=8081
POSTOP_LLM_CTX=4096

# --- Voz ---
# POSTOP_TTS=kokoro
# POSTOP_KOKORO_VOICE=ef_dora
# POSTOP_TTS_SPEED=0.95
# POSTOP_PIPER_VOICE=es_MX-claude-high.onnx
# POSTOP_VAD_SILENCE_MS=800
# POSTOP_VAD_THRESHOLD=0.35

# --- RAG ---
# POSTOP_TOP_K=2
# POSTOP_RERANKER=0
